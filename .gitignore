# 忽略 IDE 配置文件
.vscode/
.idea/
.cache/

# 忽略编译输出目录
build/
flychess_game/build/
wasm/build/

# 忽略 Emscripten 编译生成的文件
*.js
*.wasm
*.html

# 但不忽略 frontend 目录下的 index.html
!frontend/index.html
!frontend/game.js
!frontend/game.wasm

# Electron（不忽略 electron-client 源码）
!electron-client/**/*.js
!electron-client/**/*.html
electron-client/node_modules/

# 忽略临时文件
*.log
*.tmp
